{
  "name": "react-native-ops-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Native Android QR / barcode scanner for CityMall ops apps: CameraX preview, bundled ML Kit barcode model, frame-only decoding, QR | barcode switcher.",
  "main": "lib/commonjs/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "!**/__tests__",
    "!android/build"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/city-mall/react-native-ops-scanner.git"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
